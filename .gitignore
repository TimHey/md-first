node_modules/
.DS_Store
.env

# The answer key and the dataset. Neither belongs in a public repo: a canary
# code visible on GitHub could be quoted back by an agent that never fetched
# the page, which would invalidate every probe.
data/canaries.json
data/*.jsonl

# Local ops notes and the production answer key. The live hostname stays out
# of this repo: the repo names every arm path, so a searchable link between
# the two would hand an agent the map during a probe.
DEPLOY.local.md
data/canaries.prod.json
